{
  "name": "smartface-timeline",
  "version": "2.0.0",
  "author": "Grakov Ne <grakovne@gmail.com>",
  "keywords": ["pebble-app", "watchface"],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "SmartFace TimeLine",
    "uuid": "4f4a769d-878a-4b80-8871-e2fa018d8bb0",
    "sdkVersion": "3",
    "enableMultiJS": false,
    "targetPlatforms": ["emery"],
    "capabilities": ["configurable"],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": {
      "KEY_LANGUAGE": 0,
      "KEY_WINDOW_COLOR": 1,
      "KEY_TIME_TEXT_SIZE": 2,
      "KEY_DATE_FORMAT": 3,
      "KEY_SHOW_BATTERY_TEXT": 4,
      "KEY_SHOW_BLUETOOTH_TEXT": 5,
      "KEY_VIBE_HOURLY": 6,
      "KEY_VIBE_BLUETOOTH": 7,
      "KEY_NIGHT_MODE_ENABLED": 8,
      "KEY_NIGHT_MODE_START": 9,
      "KEY_NIGHT_MODE_END": 10,
      "KEY_TOP_STRING": 11,
      "KEY_BOTTOM_STRING": 12,
      "KEY_NIGHT_MODE_INVERT": 13,
      "KEY_NIGHT_MODE_UPDATE_INFO": 14,
      "KEY_NIGHT_MODE_VIBE_EVENT": 15,
      "KEY_DATA_UPDATE_FREQ": 16,
      "KEY_NIGHT_MODE_VIBE_HOURLY": 17,
      "KEY_DATE_STYLE": 18,
      "KEY_SHOW_LAST_DISCONNECT": 19,
      "KEY_BLINK_COLON": 20,
      "KEY_NIGHT_MODE_BLINK_COLON": 21,
      "KEY_ASK_DATA": 99
    },
    "resources": {
      "media": [
        { "type": "font", "name": "IMAGINE_BIG_41", "file": "fonts/bigDigits.ttf", "characterRegex": "[0-9: ]" },
        { "type": "font", "name": "IMAGINE_SMALL_37", "file": "fonts/smallDigits_fixed.ttf", "characterRegex": "[0-9: ]" },
        { "type": "font", "name": "IMAGINE_FONT_12", "file": "fonts/imagineFont.ttf", "characterRegex": "[0-9%:.\\- ]|[\\u0400-\\u04FF]|[A-Z\u00C4\u00D6\u00DC\u00DF\u00E4\u00F6\u00FC\u00C6\u00E6 ]" },
        { "type": "font", "name": "IMAGINE_FONT_17", "file": "fonts/imagineFont.ttf", "characterRegex": "[0-9.: ]|[\\u0400-\\u04FF]|[A-Z\u00C4\u00D6\u00DC\u00DF\u00E4\u00F6\u00FC\u00C6\u00E6 ]" },
        { "type": "font", "name": "IMAGINE_FONT_14", "file": "fonts/imagineFont.ttf", "characterRegex": "[ -~\u00A0-\u017F\u0400-\u04FF\u2013\u2014\u2018\u2019\u201C\u201D\u2026\u20AC]" },
        { "type": "bitmap", "name": "APP_LOGO", "file": "images/app_logo.png", "menuIcon": true, "memoryFormat": "1Bit", "spaceOptimization": "memory" },
        { "type": "bitmap", "name": "BLUETOOTH_YES_NORMAL", "file": "images/bluetooth_yes_normal.png" },
